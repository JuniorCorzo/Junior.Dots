* {
    background: #{{colors.surface.default.hex_stripped}}cc;
    background-alt: #{{colors.surface_container.default.hex_stripped}};
    foreground: #{{colors.on_surface.default.hex_stripped}};
    selected: #{{colors.primary.default.hex_stripped}};
    on-selected: #{{colors.on_primary.default.hex_stripped}};
    border-col: #{{colors.outline.default.hex_stripped}};
    primary-container: #{{colors.primary_container.default.hex_stripped}};
}
